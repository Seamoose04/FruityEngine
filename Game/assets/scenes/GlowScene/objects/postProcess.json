{
    "type": "GameObject",
    "properties": {
		"PostProcessVolume": {
			"effects": [
				{ "id": "scene", "type": "Scene" },
				{ "id": "threshold", "type": "ThresholdEffect", "input": "scene", "threshold": 0.8, "knee": 0.0 },
				{ "id": "blurred", "type": "BlurEffect", "input": "threshold", "size": 1.0, "passes": 5 },
				{ "id": "bloom", "type": "CombineEffect", "inputA": "scene", "inputB": "blurred", "method": "Add" },
				{ "id": "output", "type": "RenderToScreen", "input": "bloom" }
			]
		}
	}
}

